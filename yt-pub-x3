#!/usr/bin/env python3
"""Comandos do yt-pub-x3."""
import argparse
import json
import os
import re
import shutil
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from lib import VERSION, canais as canais_mod, config, cortes, db, entrada, importar, midia, migrar  # noqa: E402


def canal(nome):
    c = canais_mod.carregar().get(nome)
    if not c:
        sys.exit(f'canal não existe: {nome} (rode: yt-pub-x3 importar-canais)')
    return c


def enviar(a):
    """Copia a pasta para a entrada e já valida; a original fica intacta."""
    c = canal(a.canal)
    origem = os.path.abspath(a.pasta)
    if not os.path.isdir(origem):
        sys.exit('pasta não existe')
    os.makedirs(config.acervo_dir(), exist_ok=True)
    tmp = tempfile.mkdtemp(prefix='envio-', dir=config.acervo_dir())
    copia = os.path.join(tmp, os.path.basename(origem))
    shutil.copytree(origem, copia)
    con = db.connect()
    try:
        item = entrada.enfileirar_pasta(con, c, copia, simular=not config.publicar_de_verdade())
        print(f'na fila: item {item} do {a.canal}')
    except entrada.Adiar as e:
        sys.exit(f'não enviado: {e}. Informe os textos no post.json.')
    except entrada.Recusa as e:
        sys.exit(f'recusado: {e}')
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def esperar_item(item, segundos):
    """Espera o YouTube. Saída 0 com "Publicado: <url>", 4 se ainda está na fila, 5 se não vai sair."""
    limite = time.time() + segundos
    while True:
        con = db.connect()
        r = con.execute("SELECT status, url, motivo FROM entregas WHERE item_id=? AND destino='youtube'", (item,)).fetchone()
        con.close()
        if not r:
            print(f'item {item} sem entrega no YouTube', file=sys.stderr); sys.exit(5)
        if r['status'] == 'feito' and r['url']:
            print(f"Publicado: {r['url']}"); return
        if r['status'] not in ('aguardando', 'enviando', 'pausado'):
            print(f"não publicado: {r['status']}: {r['motivo']}", file=sys.stderr); sys.exit(5)
        if time.time() >= limite:
            print(f'ainda na fila: item {item}'); sys.exit(4)
        time.sleep(min(10, max(1, limite - time.time())))


def esperar(a):
    esperar_item(a.item, a.segundos)


def enviar_arquivo(a):
    """Para os produtores: recebe o vídeo pronto e entrega na fila do canal. O arquivo original fica intacto."""
    c = canal(a.canal)
    if not os.path.isfile(a.arquivo):
        sys.exit(f'arquivo não existe: {a.arquivo}')
    os.makedirs(config.acervo_dir(), exist_ok=True)
    tmp = tempfile.mkdtemp(prefix='arquivo-', dir=config.acervo_dir())
    pasta = os.path.join(tmp, re.sub(r'[^\w.-]+', '-', a.origem or os.path.basename(a.arquivo))[:50])
    os.makedirs(pasta)
    try:
        destino = os.path.join(pasta, os.path.basename(a.arquivo))
        try:
            os.link(a.arquivo, destino)
        except OSError:
            shutil.copy(a.arquivo, destino)
        if a.capa:
            shutil.copy(a.capa, os.path.join(pasta, 'capa' + (os.path.splitext(a.capa)[1].lower() or '.jpg')))
        contexto = '\n\n'.join([a.contexto or ''] + [open(x, encoding='utf-8').read() for x in a.contexto_arquivo]).strip()
        post = {'tipo': 'video', 'titulo': a.titulo or '', 'descricao': a.descricao or '', 'contexto': contexto,
                'tags': [t.strip() for t in a.tags.split(',') if t.strip()], 'sem_capa': a.sem_capa,
                'quando': a.quando, 'origem': a.origem or 'produtor'}
        with open(os.path.join(pasta, 'post.json'), 'w', encoding='utf-8') as f:
            json.dump(post, f, ensure_ascii=False)
        con = db.connect()
        try:
            item = entrada.enfileirar_pasta(con, c, pasta)
            print(f'na fila: item {item} do {a.canal}')
        except entrada.Adiar as e:
            print(f'adiado: {e}', file=sys.stderr); sys.exit(3)
        except entrada.Recusa as e:
            # Nova tentativa do produtor: o vídeo já está na fila, basta voltar a esperar.
            achado = db.ja_existe(con, a.canal, midia.sha256([a.arquivo])) if a.esperar is not None else None
            if not achado:
                print(f'recusado: {e}', file=sys.stderr); sys.exit(2)
            item = achado[0]
            print(f'já na fila: item {item} do {a.canal}')
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    if a.esperar is not None:
        esperar_item(item, a.esperar)


def status(_):
    con = db.connect()
    cs = canais_mod.carregar()
    print(f"yt-pub-x3 v{VERSION} · {'PUBLICANDO' if config.publicar_de_verdade() else 'simulação'} · {len(cs)} canais")
    for n, c in cs.items():
        r = {(x['destino'], x['status']): x['n'] for x in con.execute('SELECT destino,status,COUNT(*) n FROM entregas WHERE canal=? GROUP BY 1,2', (n,))}
        f = lambda d: ' '.join(f'{s}={q}' for (dd, s), q in sorted(r.items()) if dd == d) or '-'
        print(f"{n:8} {'ATIVO' if c['ativo'] else 'off  '} yt[{f('youtube')}] rs[{f('rs')}]")


def fila(a):
    con = db.connect()
    for r in con.execute("""SELECT e.id,e.destino,e.status,e.motivo,i.tipo,i.titulo FROM entregas e JOIN itens i ON i.id=e.item_id
                            WHERE e.canal=? ORDER BY e.id DESC LIMIT ?""", (a.canal, a.n)):
        print(f"{r['id']:5} {r['destino']:7} {r['status']:10} {r['tipo']:9} {r['titulo'][:60]} {r['motivo'][:50]}")


def acao(a):
    ok = db.acao(db.connect(), a.entrega, a.nome)
    sys.exit(0 if ok else f'{a.nome} não se aplica à entrega {a.entrega} neste estado')


def imp_canais(a):
    f, p = importar.importar(a.sobrescrever)
    print(f"criados: {len(f)} · já existiam: {len(p)} · todos com ativo: false nos novos")


def imp_lives(a):
    print(f'{cortes.importar_historico(db.connect(), canal(a.canal))} lives importadas')


def mig_clipes(a):
    """Sem --aplicar só mostra o que iria para a fila."""
    destino = canal(a.para)
    todos, fora = [], {}
    for nome in a.origem:
        c = canal(nome)
        lista, f = migrar.selecionar(nome, c['lives_dir'], a.clipes_pendentes, a.clipes_erro, a.imports_erro, a.imports_pendentes)
        todos += lista
        grupos = {}
        for x in lista:
            k = f"{x['grupo']} {x['situacao']}"
            grupos[k] = grupos.get(k, 0) + 1
        print(f'{nome}: {len(lista)} escolhidos {grupos} · fora: {dict(f)}')
    if not a.aplicar:
        print(f'total: {len(todos)} para {a.para} (nada foi alterado; use --aplicar)')
        return
    novos, rep = migrar.enfileirar(db.connect(), destino, todos)
    print(f'{a.para}: {novos} na fila · {rep} repetidos ignorados')


def cmd_login(a):
    from lib import login
    cs = canais_mod.carregar()
    if a.canal:
        cs = {a.canal: canal(a.canal)}
    if a.acao == 'copiar':
        for n, r in login.copiar(cs):
            print(f'{n:8} {r}')
        cs = canais_mod.carregar() if not a.canal else {a.canal: canal(a.canal)}
    con = db.connect()
    for n, c in cs.items():
        print(f"{n:8} {'próprio' if login.proprio(c) else 'antigo '} {login.testar(con, c)}")


def cmd_enriquecer(a):
    """Sem --aplicar só lista (lê o YouTube, não muda nada). Com --aplicar precisa de X3_PUBLICAR=1."""
    from lib import config, enriquecer
    c = canal(a.canal)
    if a.max:
        c['enriquecer']['max_por_vez'] = a.max
    con = db.connect()
    for l, m in enriquecer.candidatos(con, c):
        tem = 'com transcrição' if enriquecer.transcricao(c, l['video_id']) else 'sem transcrição (espera o corte)'
        print(f"{l['video_id']} {l['data_live']} {m:9} {tem} · {l['titulo'][:60]}")
    if not a.aplicar:
        print('nada foi alterado; use --aplicar com X3_PUBLICAR=1')
        return
    if not config.publicar_de_verdade():
        sys.exit('--aplicar exige X3_PUBLICAR=1')
    print(enriquecer.executar(con, c, False))


ap = argparse.ArgumentParser(prog='yt-pub-x3')
sub = ap.add_subparsers(dest='cmd', required=True)
p = sub.add_parser('enviar', help='põe uma pasta na fila')
p.add_argument('pasta')
p.add_argument('--canal', required=True)
p.set_defaults(f=enviar)
p = sub.add_parser('enviar-arquivo', help='produtor entrega um vídeo pronto na fila')
p.add_argument('arquivo')
p.add_argument('--canal', required=True)
for op in ('titulo', 'descricao', 'contexto', 'capa', 'origem', 'tags'):
    p.add_argument(f'--{op}', default='')
p.add_argument('--contexto-arquivo', action='append', default=[])
p.add_argument('--quando', default='fila', help='fila (padrão) ou AAAA-MM-DD HH:MM; "agora" vira fila')
p.add_argument('--sem-capa', action='store_true')
p.add_argument('--esperar', type=int, help='segundos esperando o YouTube; imprime "Publicado: <url>"')
p.add_argument('--so-youtube', action='store_true', help='ignorado: todo vídeo vai às duas filas')
p.set_defaults(f=enviar_arquivo)
p = sub.add_parser('esperar', help='espera a publicação de um item no YouTube')
p.add_argument('item', type=int)
p.add_argument('--segundos', type=int, default=0)
p.set_defaults(f=esperar)
sub.add_parser('status').set_defaults(f=status)
p = sub.add_parser('fila')
p.add_argument('canal')
p.add_argument('-n', type=int, default=30)
p.set_defaults(f=fila)
for nome in db.ACOES:
    p = sub.add_parser(nome)
    p.add_argument('entrega', type=int)
    p.set_defaults(f=acao, nome=nome)
p = sub.add_parser('importar-canais')
p.add_argument('--sobrescrever', action='store_true')
p.set_defaults(f=imp_canais)
p = sub.add_parser('importar-lives')
p.add_argument('canal')
p.set_defaults(f=imp_lives)
p = sub.add_parser('migrar-clipes', help='leva clipes de canais antigos para a fila de outro canal')
p.add_argument('origem', nargs='+')
p.add_argument('--para', required=True)
p.add_argument('--clipes-pendentes', action='store_true')
p.add_argument('--clipes-erro', action='store_true')
p.add_argument('--imports-erro', action='store_true')
p.add_argument('--imports-pendentes', action='store_true')
p.add_argument('--aplicar', action='store_true')
p.set_defaults(f=mig_clipes)
p = sub.add_parser('login', help='login próprio do YouTube: copiar das pastas antigas ou testar')
p.add_argument('acao', choices=('copiar', 'testar'))
p.add_argument('canal', nargs='?')
p.set_defaults(f=cmd_login)
p = sub.add_parser('enriquecer', help='título, descrição e capa das lives com título genérico')
p.add_argument('canal')
p.add_argument('--max', type=int, default=0)
p.add_argument('--aplicar', action='store_true')
p.set_defaults(f=cmd_enriquecer)
a = ap.parse_args()
a.f(a)
