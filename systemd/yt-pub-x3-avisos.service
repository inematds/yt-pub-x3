[Unit]
Description=yt-pub-x3: avisos das publicações no Telegram (bot dedicado)
After=network-online.target

[Service]
WorkingDirectory=%h/projetos/yt-pub-x3
# TELEGRAM_NOTIFY_BOT_TOKEN continua no .env de onde já era lido; a lista de canais fica fora do git.
EnvironmentFile=%h/projetos/yt-pub-livesx-master/config/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/projetos/yt-pub-x3/avisos.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
